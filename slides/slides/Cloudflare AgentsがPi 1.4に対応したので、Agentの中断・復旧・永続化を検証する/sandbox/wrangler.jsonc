{
  "name": "pi14-recovery-sandbox",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-25",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "ai": { "binding": "AI" },
  "durable_objects": {
    "bindings": [{ "name": "LAB", "class_name": "RecoveryLab" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RecoveryLab"] }]
}
